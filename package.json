{
  "name": "devin-better-acp",
  "displayName": "Devin Better ACP",
  "description": "Shows Codex and Antigravity CLI allowance usage in the status bar.",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "publisher": "cet",
  "repository": {
    "type": "git",
    "url": "https://github.com/cetio/devin-better-acp.git"
  },
  "icon": "images/at.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/source/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Usage monitoring is paused until the workspace is trusted. Status-bar connection information remains visible."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "devinBetterACP.showUsage",
        "title": "Show Usage",
        "category": "Devin Better ACP"
      },
      {
        "command": "devinBetterACP.refreshAll",
        "title": "Refresh All",
        "category": "Devin Better ACP"
      },
      {
        "command": "devinBetterACP.retry",
        "title": "Retry Connection",
        "category": "Devin Better ACP"
      },
      {
        "command": "devinBetterACP.configureCli",
        "title": "Configure CLI Path",
        "category": "Devin Better ACP"
      },
      {
        "command": "devinBetterACP.openSettings",
        "title": "Open Settings",
        "category": "Devin Better ACP"
      },
      {
        "command": "devinBetterACP.openChatGptUsage",
        "title": "Open ChatGPT Usage Page",
        "category": "Devin Better ACP"
      },
      {
        "command": "devinBetterACP.installAntigravity",
        "title": "Install Devin Better Antigravity",
        "category": "Devin Better ACP"
      }
    ],
    "configuration": [
      {
        "title": "Devin Better ACP",
        "properties": {
          "devinBetterACP.codex.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "Show Codex subscription allowance in the status bar."
          },
          "devinBetterACP.codex.path": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "description": "Absolute path to the codex CLI. Leave empty to search PATH and ~/.local/bin."
          },
          "devinBetterACP.refreshIntervalSeconds": {
            "type": "number",
            "default": 180,
            "minimum": 0,
            "scope": "application",
            "description": "Seconds between background refreshes, including while unfocused. 0 disables background polling; positive values below 60 are allowed."
          },
          "devinBetterACP.statusBar.alignment": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "default": "right",
            "scope": "application",
            "description": "Status-bar side for the usage items."
          },
          "devinBetterACP.statusBar.showCodex": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "Show the Codex status-bar item."
          }
        }
      },
      {
        "title": "Devin Better Antigravity",
        "properties": {
          "devinBetterACP.antigravity.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "Show Antigravity CLI allowance in the status bar."
          },
          "devinBetterACP.antigravity.path": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "description": "Absolute path to the agy CLI. Leave empty to search PATH and ~/.local/bin."
          },
          "devinBetterACP.statusBar.showAntigravity": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "Show the Antigravity status-bar item."
          },
          "devinBetterACP.antigravity.spoofZed": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "Send the Zed client name to Antigravity for compatibility. Takes effect after Devin: Reload ACP Connections."
          },
          "devinBetterACP.antigravity.devinMcp": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "Merge Devin MCP servers into Antigravity sessions. Takes effect after Devin: Reload ACP Connections."
          },
          "devinBetterACP.antigravity.systemPrompt": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "description": "Use the adapted Devin system prompt in a temporary Antigravity launch copy. Takes effect after Devin: Reload ACP Connections."
          }
        }
      }
    ]
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit && npm run test:acp",
    "test:unit": "node --test \"dist/tests/unit/{cli,config,extension,parse,poll,usage}.js\" \"dist/tests/unit/antigravity/{config,install,usage}.js\" \"dist/tests/unit/codex/{config,usage}.js\" \"dist/tests/unit/ui/{format,picker,status}.js\"",
    "test:acp": "python3 -m unittest discover -s tests/unit/acp -p '*.py'",
    "test:integration": "npm run build && node .devin/runintegration.mjs",
    "package:files": "vsce ls --no-dependencies --ignoreFile .devin/packageignore",
    "package": "npm run build && vsce package --no-dependencies --ignoreFile .devin/packageignore --out bin/devin-better-acp-1.0.0.vsix"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "7.0.2"
  }
}
